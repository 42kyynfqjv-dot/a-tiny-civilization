# Local-only PostgreSQL credentials. Replace every production value.
POSTGRES_DB=civilization
POSTGRES_USER=civilization
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://civilization:local-development-only@db:5432/civilization

# Service configuration
APP_ENV=development
RUST_LOG=info
API_BIND=0.0.0.0:8080
PUBLIC_ORIGIN=http://localhost:3000
RUNNER_HEARTBEAT_SECONDS=5
RUNNER_TICK_MILLISECONDS=1000

# Optional adapters. The deterministic simulation works without these values.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=

# Deployment-only. Leave blank for local development.
CLOUDFLARE_TUNNEL_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
