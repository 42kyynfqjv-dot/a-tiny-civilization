# Local-only PostgreSQL credentials. Replace every production value.
POSTGRES_DB=civilization
POSTGRES_USER=civilization
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://civilization:local-development-only@db:5432/civilization

# Service configuration
APP_ENV=development
RUST_LOG=info
API_BIND=0.0.0.0:8080
PUBLIC_ORIGIN=http://localhost:3000
RUNNER_HEARTBEAT_SECONDS=5
RUNNER_TICK_MILLISECONDS=60000

# Optional adapters. The deterministic simulation works without these values.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
# Set to 1 only after the local-model cache has been populated.
HINDSIGHT_HF_OFFLINE=0
MEMORY_WORKER_ID=local-memory-worker
MEMORY_WORKER_REPLICAS=2
MEMORY_POLL_MILLISECONDS=10
MEMORY_CLAIM_LEASE_SECONDS=60
HINDSIGHT_REQUEST_TIMEOUT_SECONDS=15

# Free-first cognition ladder. Leave a provider blank to skip it durably.
COGNITION_WORKER_ID=local-cognition-worker
COGNITION_POLL_MILLISECONDS=250
COGNITION_CLAIM_LEASE_SECONDS=60
# Long enough for the pinned CPU model to prefill a bounded prompt, while still
# shorter than the default 60-second wall window to its simulation deadline.
COGNITION_REQUEST_TIMEOUT_SECONDS=45
# Production Compose uses the exact internal-only service URL below. A host-run
# worker may instead use an uncredentialed loopback HTTP URL.
LOCAL_COGNITION_BASE_URL=http://local-cognition:11434/v1
# Required before any configured provider receives private cognition and recalled-memory context.
COGNITION_EXTERNAL_EXPORT_APPROVED=false
# Account-scoped OpenAI-compatible endpoint, ending in /ai/v1.
CLOUDFLARE_WORKERS_AI_BASE_URL=
CLOUDFLARE_WORKERS_AI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Dedicated provider-capped key for Cancer World's paid V4 Pro -> V4 Flash route.
# This credential is never eligible for Earth Genesis or general free-first jobs.
CANCER_OPENROUTER_API_KEY=
CANCER_CONSOLE_TOKEN=
# Assigned only after Cancer World genesis is committed.
CANCER_WORLD_ID=
# The approved paid DeepSeek route is unreachable unless this is explicitly true.
COGNITION_PAID_ENABLED=false
# Cancer World exports only its bounded research prompt/evidence bundle. Both
# switches must be intentionally enabled for external and paid research calls.
CANCER_RESEARCH_EXTERNAL_EXPORT_APPROVED=false
CANCER_RESEARCH_PAID_ENABLED=false
CANCER_FIREWORKS_API_KEY=
CANCER_EVIDENCE_REFRESH_SECONDS=21600
CANCER_EVIDENCE_PAGE_SIZE=24
CANCER_EVIDENCE_ENDPOINT=https://www.ebi.ac.uk/europepmc/webservices/rest/search
CANCER_RESEARCH_PAID_RESERVATION_MICRO_USD=150000

# Deployment-only. Leave blank for local development.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional override; production preflight requires an immutable @sha256 digest.
CLOUDFLARED_IMAGE=
# Private Cloudflare R2 destination for encrypted PostgreSQL WAL and base backups.
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Generate once with `openssl rand -hex 32`; loss makes backups unrecoverable.
WALG_LIBSODIUM_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPPORTER_PRICE_ID=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_LIVE_MODE=false
STRIPE_SUPPORTER_CURRENCY=usd
STRIPE_SUPPORTER_AMOUNT_MINOR=500
STRIPE_SUCCESS_URL=https://atinycivilization.com/?supporter=success
STRIPE_CANCEL_URL=https://atinycivilization.com/?supporter=cancelled
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://atinycivilization.com/api/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://atinycivilization.com/api/v1/auth/apple/callback
# Hosted newsletter-provider forms. The application never receives subscriber email addresses.
NEWSLETTER_WEEKLY_SIGNUP_URL=
