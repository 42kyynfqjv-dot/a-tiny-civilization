[Unit]
Description=A Tiny Civilization Cancer World evidence intake
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shmuel
Group=shmuel
WorkingDirectory=/home/shmuel/codex/emergent-civilization
EnvironmentFile=/etc/a-tiny-civilization-production.env
Environment=CANCER_NCI60_CHALLENGE_CATALOGUE_PATH=/home/shmuel/codex/emergent-civilization/data/cancer-research/nci-cellminer-2-15-cns-challenge-catalogue-v1.json
Environment=CANCER_NCI60_ANSWER_KEY_PATH=/run/atiny-cancer-evidence/nci60/559d52f45f18901d3ce8fb844f99cd88045ccd3fbd0c99cb7e8139b85e59f4ce/nci-cellminer-2-15-cns-challenge-answer-key-v1.json
RuntimeDirectory=atiny-cancer-evidence
RuntimeDirectoryMode=0750
# Staging remains under the same unprivileged account as the worker; systemd
# never executes repository-owned code as root. Files are published mode 0444.
ExecStartPre=/usr/bin/env bash /home/shmuel/codex/emergent-civilization/scripts/stage-cancer-nci60-qualification-key.sh --source /home/shmuel/codex/emergent-civilization/data/source-cache/nci-cellminer-2026-08-12/nci-cellminer-2-15-cns-challenge-answer-key-v1.json --runtime-root /run/atiny-cancer-evidence/nci60
ExecStartPre=/usr/bin/env bash /home/shmuel/codex/emergent-civilization/scripts/stage-cancer-pdc000711-evidence.sh --proteome /home/shmuel/codex/emergent-civilization/data/derived-cache/pdc000711-hcmi-gbm-proteome/pdc000711-gbm-proteome.tsv --metadata /home/shmuel/codex/emergent-civilization/data/derived-cache/pdc000711-hcmi-gbm-proteome/pdc000711-gbm-proteome.metadata.json --runtime-root /run/atiny-cancer-evidence/pdc000711
ExecStart=/usr/bin/env bash /home/shmuel/codex/emergent-civilization/scripts/run-cancer-evidence-with-pdc000711.sh
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/atiny-cancer-evidence
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
