[Unit]
Description=A Tiny Civilization Cancer World model research worker
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shmuel
Group=shmuel
WorkingDirectory=/home/shmuel/codex/emergent-civilization
EnvironmentFile=/etc/a-tiny-civilization-production.env
Environment=CANCER_RESEARCH_WORKER_ID=host-cancer-research-worker-1
ExecStart=/home/shmuel/codex/emergent-civilization/target/release/civilization-runner cancer-research-worker
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Defense in depth: this host worker shares the project owner account for
# outbound HTTPS, but its mount namespace cannot see either the ignored labels
# or the evidence worker's staged qualification tree.
InaccessiblePaths=-/home/shmuel/codex/emergent-civilization/data/source-cache/nci-cellminer-2026-08-12/nci-cellminer-2-15-cns-challenge-answer-key-v1.json -/run/atiny-cancer-evidence
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
