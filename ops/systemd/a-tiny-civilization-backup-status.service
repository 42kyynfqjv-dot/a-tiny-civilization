[Unit]
Description=A Tiny Civilization PostgreSQL backup freshness check
Documentation=https://github.com/42kyynfqjv-dot/a-tiny-civilization/blob/main/docs/operations/BACKUP_RESTORE.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/a-tiny-civilization
EnvironmentFile=/etc/a-tiny-civilization-production.env
ExecStart=/usr/bin/env bash ./scripts/backup-status.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/docker
