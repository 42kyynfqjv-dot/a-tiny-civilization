[Unit]
Description=A Tiny Civilization bounded Cancer World tissue-refinement worker
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shmuel
Group=shmuel
WorkingDirectory=/home/shmuel/codex/emergent-civilization
EnvironmentFile=/etc/a-tiny-civilization-production.env
Environment=CANCER_TISSUE_WORKER_ID=host-cancer-tissue-worker-1
Environment=CANCER_TISSUE_POLL_MILLISECONDS=5000
Environment=CANCER_TISSUE_CLAIM_LEASE_SECONDS=900
ExecStart=/home/shmuel/codex/emergent-civilization/target/release/civilization-runner cancer-tissue-refinement-worker
Restart=on-failure
RestartSec=15s
RuntimeMaxSec=30m
CPUQuota=100%
MemoryMax=1536M
MemorySwapMax=0
TasksMax=32
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# This worker is deterministic and database-only: loopback is permitted for the
# host PostgreSQL listener, while every non-loopback IP destination is denied.
# It cannot read qualification datasets, model credentials, research-memory
# staging, or call external APIs.
InaccessiblePaths=-/home/shmuel/codex/emergent-civilization/data/source-cache -/home/shmuel/codex/emergent-civilization/data/derived-cache -/home/shmuel/codex/emergent-civilization/data/cancer-research/tcga-gbm-dr46-patient-baseline-v1.json -/run/atiny-cancer-evidence
UnsetEnvironment=CANCER_OPENROUTER_API_KEY CANCER_FIREWORKS_API_KEY HETZNER_VLLM_API_KEY OPENROUTER_API_KEY HINDSIGHT_API_KEY CLOUDFLARE_WORKERS_AI_API_KEY GROQ_API_KEY CEREBRAS_API_KEY CANCER_CONSOLE_TOKEN CLOUDFLARE_TUNNEL_TOKEN R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY WALG_LIBSODIUM_KEY STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET GOOGLE_OAUTH_CLIENT_SECRET APPLE_PRIVATE_KEY CANCER_PDC000711_PROTEOME_PATH CANCER_PDC000711_PROTEOME_METADATA_PATH CANCER_TCGA_GBM_TARGET_CONTEXT_PATH

[Install]
WantedBy=multi-user.target
